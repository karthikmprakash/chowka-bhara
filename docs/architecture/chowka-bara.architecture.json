  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "One Worker serves the rendered page, static assets and the room API",
        "Every live table is a Durable Object keyed by its six-character code",
        "The object generates throws, applies the engine and pushes state over WebSockets",
        "No database: a table is deleted fifteen minutes after the last seat leaves"
      ]
    },
    {
      "dot": "emerald",
      "title": "Web client",
      "items": [
        "Board, cowrie tray, match HUD and journey guide are client components",
        "Local play, saved games and preferences live in localStorage",
        "Online play holds one socket per seat and reconnects automatically",
        "Phone layout is five screens; desktop keeps the single page"
      ]
    },
    {
      "dot": "violet",
      "title": "Phone shell",
      "items": [
        "Capacitor WebView loads the deployed Worker over HTTPS",
        "NativeShellPlugin supplies safe-area insets, keep-awake and immersive mode",
        "Haptics on throw and landing; native share sheet for room codes"
      ]
    },
    {
      "dot": "amber",
      "title": "Release pipeline",
      "items": [
        "Pull request → CI: typecheck, lint, tests, build",
        "Merge to main deploys the Worker; vX.Y.Z tag builds a signed AAB + APK",
        "Play upload lands as an internal-track draft for a human to promote",
        "Secrets: Android keystore, Play service account, Cloudflare API token"
      ]
    },
    {
      "dot": "slate",
      "title": "Local development",
      "items": [
        "vinext dev + the room object run inside one Miniflare instance on :5173",
        "Debug APK targets localhost through adb reverse (-PlocalServerUrl)"
      ]
    }
  ]
}